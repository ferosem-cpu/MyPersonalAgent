# LLM API Keys (provide at least one for auto-fallback)
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
GROK_API_KEY=...
NVIDIA_API_KEY=nvapi-...
NVIDIA_API_KEY_2=nvapi-...

# Optional: Force specific provider (overrides auto-fallback)
# LLM_PROVIDER=anthropic

# Telegram Integration (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firestore (optional)
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# REST API server (agent/run_api.py) - required to use the API/Android app
# generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=

# WhatsApp bridge (agent/services/wa-bridge/, agent/run_wa_bridge.bat) - Task 5.2
# generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
WA_BRIDGE_KEY=
# WA_BRIDGE_PORT=8600

# Telegram user session (agent/setup_telegram_user.py) - Task 5.3
# get both from https://my.telegram.org (API development tools)
TG_API_ID=
TG_API_HASH=
