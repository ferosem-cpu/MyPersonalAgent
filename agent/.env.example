# LLM API Keys (provide at least one for auto-fallback)
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
GROK_API_KEY=...
NVIDIA_API_KEY=nvapi-...
NVIDIA_API_KEY_2=nvapi-...

# Optional: Force specific provider (overrides auto-fallback)
# LLM_PROVIDER=anthropic

# Telegram Integration (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firestore (optional)
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# REST API server (agent/run_api.py) - required to use the API/Android app
# generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=
